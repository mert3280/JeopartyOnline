# Copy to .env beside server.py. Never commit real credentials.
QUESTION_STORAGE=mongodb
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=jeoparty
# Master password: can edit, rename or delete any question set.
# Each set also has its own creator password, chosen when it's made.
# Quote it if it contains spaces, # or quotes.
MASTER_PASSWORD='choose-a-password'
# Optional: your public HTTPS address (Render uses its own address automatically).
# PUBLIC_URL=https://your-service.onrender.com
# Optional for running on your laptop with a public tunnel:
# NGROK_AUTHTOKEN=your-token
